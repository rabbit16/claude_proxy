[Unit]
Description=Claude Code Proxy (TeamoRouter)
Documentation=file:///mnt/data/claude_code_proxy/restart.sh
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/mnt/data/claude_code_proxy
# 上游 api.teamorouter.cn 国内可直连，不再经本机代理。
# 数据库连接串等敏感配置放在 .env（600）；文件不存在时不影响启动。
EnvironmentFile=-/mnt/data/claude_code_proxy/.env
Environment=TEAMO_API_KEY_FILE=/etc/claude_code_proxy/teamo_api_key
Environment=HEADROOM_ENABLED=0
Environment=HEADROOM_KOMPRESS=0
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/anaconda3/envs/claude_code/bin/python3.12 main.py
Restart=always
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=20s
KillMode=mixed
KillSignal=SIGTERM
LimitNOFILE=65535
StandardOutput=append:/mnt/data/claude_code_proxy/nohup.out
StandardError=append:/mnt/data/claude_code_proxy/nohup.out

[Install]
WantedBy=multi-user.target
