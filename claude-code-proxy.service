[Unit]
Description=Claude Code Proxy (TeamoRouter)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
# 路径由 install-service.sh 安装时按实际目录和 python 填充，换机不用手改本文件。
WorkingDirectory=@APP_DIR@
# 数据库连接串等敏感配置放在 .env（600）；文件不存在时不影响启动。
# 上游 api.teamorouter.cn 国内可直连，不再经本机代理。
EnvironmentFile=-@APP_DIR@/.env
Environment=APP_PORT=@APP_PORT@
Environment=TEAMO_API_KEY_FILE=@TEAMO_API_KEY_FILE@
Environment=HEADROOM_ENABLED=0
Environment=HEADROOM_KOMPRESS=0
Environment=PYTHONUNBUFFERED=1
ExecStart=@PYTHON@ main.py
Restart=always
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=20s
KillMode=mixed
KillSignal=SIGTERM
LimitNOFILE=65535
StandardOutput=append:@APP_DIR@/nohup.out
StandardError=append:@APP_DIR@/nohup.out

[Install]
WantedBy=multi-user.target
