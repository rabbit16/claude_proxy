# 复制为 .env 或导出到环境变量后再启动服务。切勿提交真实密钥。
#
# 上游 API Key。优先级：TEAMO_API_KEY > settings/macro.py 手填值 > TEAMO_API_KEY_FILE
TEAMO_API_KEY=
# 也可以把密钥单独放到一个仅本人可读（chmod 600）的文件里
TEAMO_API_KEY_FILE=/etc/claude_code_proxy/teamo_api_key

# 上游路由：teamo（默认）/ legacy / yunxin
UPSTREAM_PROVIDER=teamo
TEAMO_UPSTREAM_BASE=https://api.teamorouter.com
# 仅本机代理需要时填写
TEAMO_HTTP_PROXY=

# 数据库连接串（必填，不要使用仓库内的占位值）
# 格式：mysql+aiomysql://user:password@host:port/dbname
DATABASE_URL=

# 性能与容量调节（可选）
# PROXY_PROFILE=default
