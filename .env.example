# 复制为 .env（chmod 600）或导出到环境变量后再启动服务。切勿提交真实密钥。
# 项目未引入 python-dotenv：.env 由 restart.sh 加载，或 systemd 用 EnvironmentFile 加载。
# 已存在的环境变量优先，.env 只补空缺。
#
# 上游 API Key。优先级：TEAMO_API_KEY > settings/macro.py 手填值 > TEAMO_API_KEY_FILE
TEAMO_API_KEY=
# 号商（UPSTREAM_PROVIDER=yunxin）时使用
YUNXIN_API_KEY=
# 也可以把密钥单独放到一个仅本人可读（chmod 600）的文件里
TEAMO_API_KEY_FILE=/etc/claude_code_proxy/teamo_api_key

# 上游路由：teamo（默认）/ legacy / yunxin
UPSTREAM_PROVIDER=teamo
TEAMO_UPSTREAM_BASE=https://api.teamorouter.cn
# 仅本机代理需要时填写
TEAMO_HTTP_PROXY=
# 后台勾选 use_proxy 的号商使用的代理；留空则回落到 TEAMO_HTTP_PROXY
VENDOR_HTTP_PROXY=

# 数据库连接串（必填，不要使用仓库内的占位值）
# 格式：mysql+aiomysql://user:password@host:port/dbname
DATABASE_URL=

# 性能与容量调节（可选）
# PROXY_PROFILE=default
# 上游单次写超时（秒）。httpx 对 bytes body 只发一次，等于整包上传预算；
# 大上下文 + 低上行带宽时 60s 会误判断连。默认 300。
# UPSTREAM_WRITE_TIMEOUT=300

# 请求体 gzip：agent 上下文高度重复，实测 2MB 可压到 14KB，显著缩短上传时间。
# 超过该字节数才压缩，小请求不值得花 CPU。默认 262144（256KB）。
# UPSTREAM_GZIP_MIN_BYTES=262144
# 压缩级别。1 与 6 的压缩率几乎相同，但快很多，默认 1。
# UPSTREAM_GZIP_LEVEL=1
# 不认 gzip 请求体的号商在此排除（逗号分隔 vendor code）。
# 已实测兼容：jichumo / tongtong / namx / teamo。默认空（全部开启）。
# UPSTREAM_GZIP_SKIP_VENDORS=tongtong

# 历史图片转文字。开启后，若模型上一轮在回复里留下图片笔记
# （<image_memo>…</image_memo> 或 <!-- image_memo: … -->），代理会把历史轮次的
# 图片块替换成笔记正文，后续对话不再重复上传几 MB 的 base64。
# 仅替换最后一个 user 消息之前的历史，当前轮新图仍原样发给上游。
# 配合后台 tb_prompt_injection 里要求模型输出图片笔记的提示一起使用，
# 详见 README「历史图片转文字（image memo）」。
# IMAGE_MEMO_ENABLED=0
# 笔记正文最大字符数，超出截断。
# IMAGE_MEMO_MAX_CHARS=4000
# 命中的历史带图消息数达到该值才替换（灰度用）。
# IMAGE_MEMO_MIN_IMAGES=1

# 生图统一价：命中后每张固定扣该人民币金额，不看用户倍率、折扣和分辨率档位。
# 格式 `vendor_code:模型前缀[:每张元数]`，逗号分隔多条；前缀可用 | 并列。
# 默认：jichumo 下 gpt-image* 与 chatgpt-image* 统一 0.1 元/张。
# IMAGE_FLAT_PRICE_RULES=jichumo:gpt-image|chatgpt-image:0.1
